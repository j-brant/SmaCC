	| annotations ""short"" 'token' {{ShortType}}
	| annotations ""int"" 'token' {{IntType}}
	| annotations ""long"" 'token' {{LongType}}
	| annotations ""char"" 'token' {{CharType}}
	| annotations ""float"" 'token' {{FloatType}}
	| annotations ""double"" 'token' {{DoubleType}}
	;
numeric_type
	: integral_type 
	| floating_point_type 
	;
integral_type 
	: ""byte"" 'token' {{ByteType}}
	| ""short"" 'token' {{ShortType}}
	| ""int"" 'token' {{IntType}}
	| ""long"" 'token' {{LongType}}
	| ""char"" 'token' {{CharType}}
	;
floating_point_type 
	: ""float"" 'token' {{FloatType}}
	| ""double"" 'token' {{DoubleType}}
	;
reference_type 
	: class_or_interface_type 
	| array_type 
	;
annotated_reference_type
	: class_type
	| array_type
	;
annotated_type
	: annotated_primitive_type
	| annotated_reference_type
	;
annotation_list
