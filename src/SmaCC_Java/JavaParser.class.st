	| compact_members_no_method compact_member_no_method 'declaration'
	;
compact_member_no_method
	: field_declaration
	| type_declaration
	;
class_member_declarations
	: class_member_declaration 'declaration'
	| class_member_declarations class_member_declaration 'declaration'
	;
module
