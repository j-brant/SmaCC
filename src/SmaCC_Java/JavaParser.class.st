	;
class_type 
	: annotations type_name 'name' {{ClassType}}
	;
interface_type 
	: annotations type_name 'name' {{ClassType}}
	;		
array_type 
	: primitive_type 'baseType' dims {{ArrayType}}
	| type_name 'baseType' dims {{ArrayType}}
	;
