module_body_item
	: ""requires"" 'requiresToken' requires_modifiers name 'name' "";"" 'semicolon' {{ModuleRequires}}
	| ""opens"" 'opensToken' name 'name' (""to"" 'toToken' export_to_names)? "";"" 'semicolon' {{ModuleOpens}}
	| ""exports"" 'exportsToken' name 'name' (""to"" 'toToken' export_to_names)? "";"" 'semicolon' {{ModuleExports}}
	| ""uses"" 'usesToken' name 'name' "";"" 'semicolon' {{ModuleUses}}
	| ""provides"" 'providesToken' name 'name' ""with"" 'withToken' with_names "";"" 'semicolon' {{ModuleProvides}}
	;
requires_modifiers
	:
	| ""static"" 'staticToken'
	| ""transitive"" 'transitiveToken'
	| ""static"" 'staticToken' ""transitive"" 'transitiveToken'
	| ""transitive"" 'transitiveToken' ""static"" 'staticToken'
	;
with_names
	: (name 'withName' "","" 'comma')* name 'withName'
	;
export_to_names
	: (name 'toName' "","" 'comma')* name 'toName'
	;
import_declarations 
	: import_declaration 'import' 
	| import_declarations import_declaration 'import'
	;
type_declarations 
	: type_declaration 'typeDeclaration' 
	| type_declarations type_declaration 'typeDeclaration' 
	;
package_declaration 
